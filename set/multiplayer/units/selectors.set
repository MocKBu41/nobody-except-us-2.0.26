(define "generic_hqcar"
    {charge %c}
    {score %sc}
    {icon %i}
    {tags "%t"}
    {group "%g"}
    {button "%b"}
    {cw %cw}
    {cp %cp}
)
(define "hqcar"
    ("generic_hqcar" c(%c) sc(%sc) t(%t %s %brig) g(%g) i(%i) b(%b) cw(%cw) cp(%cp))
;    {content "* ( mp2/%s/vehicle_supporter:3  mp2/%s/oficer:%n )"}
    {fore 1}
)

{"vvs_mp_flag"              ("hqcar" c(1800) brig(vvs) t(all hqcar low_brig_hqcar) s(rus) n(2) g(hqcar_support)   sc(1) b(hqcar) i(1) cw(0) cp(-200)) {cost 65}}
