(define "how"
    {"%name(%side)"
        {charge %c}
        {score %sc}
        {icon %i}
        {charge %c}
        {content "%c1 ( mp2/%side/vehicle_supporter:4 ) %c2 ( mp2/%side/vehicle_supporter:2 )"}
        {tags "all cannon heavy_art fixed %side %t %brig"}
        {group "%g"}
        {button "%b"}
        {cost %cost}
        {fore %f}
        {info %c2}
    }
)
