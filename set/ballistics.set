;rXX is ratio of range XX to aim range. Bullet ballistics shouldnt depend on aim range, so on given range each aimrange macros gives equal relative damage damping
;for example, for range 50m damage coefficient of 545 is 1.04 for weapons with aim range 40 and 70
("cw_bullets" aimrange(15) r15(1.00) r20(1.33) r40(2.67) r50(3.33) r60(4.00) r70(4.67) r85(5.67) r100(6.67) r120(8))
("cw_bullets" aimrange(25) r15(0.60) r20(0.80) r40(1.60) r50(2.00) r60(2.40) r70(2.80) r85(3.40) r100(4.00) r120(4.80))
("cw_bullets" aimrange(40) r15(0.38) r20(0.50) r40(1) r50(1.25) r60(1.5) r70(1.75) r85(2.13) r100(2.5) r120(3))
("cw_bullets" aimrange(50) r15(0.3) r20(0.4) r40(0.8) r50(1) r60(1.2) r70(1.4) r85(1.7) r100(2) r120(2.4))
("cw_bullets" aimrange(60) r15(0.25) r20(0.33) r40(0.67) r50(0.83) r60(1.00) r70(1.17) r85(1.42) r100(1.67) r120(2))
("cw_bullets" aimrange(70) r15(0.21) r20(0.29) r40(0.57) r50(0.71) r60(0.86) r70(1) r85(1.21) r100(1.43) r120(1.71))
("cw_bullets" aimrange(85) r15(0.18) r20(0.24) r40(0.47) r50(0.59) r60(0.71) r70(0.82) r85(1) r100(1.18) r120(1.41))
("cw_bullets" aimrange(100) r15(0.15) r20(0.2) r40(0.4) r50(0.5) r60(0.6) r70(0.7) r85(0.85) r100(1) r120(1.2))
("cw_bullets" aimrange(120) r15(0.15) r20(0.2) r40(0.4) r50(0.5) r60(0.6) r70(0.7) r85(0.85) r100(1) r120(1.2))
}
