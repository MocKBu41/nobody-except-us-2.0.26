;ChnMod
{ballistics
	; damage damping based on armor/damage ratio
	{damping
		{0		1.0}
		{1		1.0}
		{1.5	0.5}
		{2		0.3}
		{3		0.1}
		{10		0.0}
	}

	{curve "linear"
		{0		1}
		{1		1}
		{1.01	0}
	}

	{curve "cumulative"
		{0		1.0}	; 0  250
		{0.2	1.0}	; 5  250
		{0.4	0.4}	; 10 100
		{0.8	0.2}	; 20 50
		{1.2	0.1}    ; 30 20
		{2.0	0.0}
	}
    {curve "cumulative2" 
        {0      1.0} 
        {1.0    1.0}     
        {1.5    1.0}     
        {2.0    1.0}     
    }

(mod "mp"
	{curve "cumulative"
		{0		1.0}
		{1.0	1.0}	
		{1.5	0.2}	
		{2.0	0.0}    
	}
)
    ; distance/aim range  --- damage scale
	{curve "bullet"
			{0		2}
			{0.2	1.2}
			{0.4	0.6}
			{0.6	0.5}
			{1.0	0.4}
			{2.0	0.3}
			{4.0	0.1}
	}
	
	{curve "gun_std"
		{0.1	1.0}
		{0.5	0.7}
		{1.0	0.4}
		{2.0	0.2}
		{4.0	0.0}
	}

	{curve "gun_light"
		(mod not "mp"
			{0.2	1.0}
			{1.0	0.5}
			{1.4	0.3}
			{2.5	0.0}
		)
		(mod "mp"
			{0.2	1.0}
			{1.0	0.3}
			{1.4	0.1}
			{2.5	0.0}
		)
	}
	
	{curve "gun_medium"
		(mod not "mp"
			{0.15	0.6}
			{1.0	0.3}
			{1.5	0.1}
			{3.0	0.0}
		)
		(mod "mp"
			{0.15	0.4}
			{1.0	0.1}
			{2.5	0.0}
		)
	}

	{curve "gun_heavy"
		(mod not "mp"
			{0.1	0.6}
			{1.0	0.3}
			{1.5	0.1}
			{3.0	0.0}
		)
		(mod "mp"
			{0.1	0.4}
			{0.6	0.1}
			{1.0	0.1}
			{2.5	0.0}
		)
	}

(mod "dl_tactics"
	{curve "bullet"
		{0		4.0}
		{0.15	3.0}
		{0.3	3.0}
		{0.5	1.0}
		{0.7	1.0}
		{1.0	0.9}
		{2.0    0}
	}
)


